---
import { getCollection, render } from "astro:content";
import Invite from "../../components/Invite.astro";
import RsvpForm from "../../components/RsvpForm";
import Layout from "../../layouts/Layout.astro";
import { resolveTheme } from "../../lib/themes";

// This route uses the static-prerender pattern (getStaticPaths + Astro.props),
// so it must opt into prerendering even though `output: "server"` is set.
export const prerender = true;

// 1. Generate paths for all matching static files at build time
export async function getStaticPaths() {
	const events = await getCollection("event");

	return events.map((event) => ({
		params: { eventId: event.id },
		props: { event },
	}));
}

const { event } = Astro.props;

const theme = resolveTheme(event.data.theme);

const themeStyle = `--font-heading: ${theme.fonts.heading}; --font-body: ${theme.fonts.body}; --color-accent: ${theme.accent};`;

const { Content } = await render(event);
---

<Layout
	pageTitle={event.data.title}
	ogTitle={`${event.data.title} — You're invited`}
	ogDescription={`${[event.data.subtitle, event.data.date, event.data.time].filter(Boolean).join(" · ")}`}
	ogImage={`/og/${event.id}.png`}
>
	<div style={themeStyle} data-theme={theme.id}>
		<Invite event={event} theme={theme} />

		<section id="rsvp" class="scroll-mt-6 px-6 pt-2 pb-12 sm:pt-3 sm:pb-16">
			<div class="mx-auto mt-8 max-w-md min-h-[640px]">
				<RsvpForm eventId={event.id} client:load />
			</div>
		</section>

		<Content />
	</div>
</Layout>
