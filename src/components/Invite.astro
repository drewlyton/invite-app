---
import type { CollectionEntry } from "astro:content";
import {
	GROUND_FILL_ALPHA,
	GROUND_TEXTURE_CSS_SCALE,
	GROUND_TEXTURE_TILE_HEIGHT,
	GROUND_TEXTURE_TILE_WIDTH,
	groundTextureCssUrl,
	resolveGroundColor,
	resolveGroundFarColor,
} from "../lib/runner-ground";
import { deadStatus, IDLE_STATUS } from "../lib/runner-status";
import { MAX_SCORE } from "../lib/scores";
import type { Theme } from "../lib/themes";
import EventDetails from "./EventDetails.astro";
import RsvpLink from "./RsvpLink.astro";
import RunnerGame from "./RunnerGame";

interface Props {
	event: CollectionEntry<"event">;
	theme: Theme;
}

const { event, theme } = Astro.props;
const { title, subtitle, date, time, location, rsvp_by } = event.data;

const heroStyle = [
	theme.stars ? `--star-color: ${theme.stars.color};` : "",
	`background: ${theme.heroBg};`,
	`color: ${theme.heroText};`,
]
	.filter(Boolean)
	.join(" ");

const titleStyle = theme.accentTextShadow
	? `text-shadow: ${theme.accentTextShadow};`
	: "";

// The pixel-font themes stack their hero text tightly. `game-night` keeps the
// original rhythm (the dates block still follows it). `game-night-light` moved
// its details below the fold, so the wide gap that separated the subtitle from
// the <hr> is no longer needed and the lockup tightens up.
const pixelHero = theme.id === "game-night" || theme.id === "game-night-light";
const titleMargin = pixelHero ? "margin-top: 1.5rem;" : "";
const subtitleMargin = theme.detailsBelowFold
	? "margin-top: 1rem;"
	: pixelHero
		? "margin-top: 2rem;"
		: "";

// The sky layers compose two transforms: the inner strip carries the island's
// player parallax, and the cloud layer's outer element additionally runs the
// ambient CSS drift. A transform can consume up to one section width, so the
// cloud strip needs three copies to stay covered when the drift and the player
// offset overlap at the right edge; with two it runs out of content there.
//
// Stars have no ambient drift (they hold still until the player moves), so the
// player offset alone would be safe with two copies. The constant stays shared
// at three so both families keep one strip geometry, and the spare copy costs
// nothing. Do not "optimise" it to two: that would break the clouds.
const SKY_COPIES = 3;

type StarLayer = {
	className: string;
	delay: string;
	// Parallax depth: world pixels are multiplied by this. The far 2px specks
	// move slowest, the near 4px specks a little faster, clouds fastest.
	rate: string;
};

const starLayers: StarLayer[] = [
	{ className: "hero-stars-1-a", delay: "0s", rate: "0.10" },
	{ className: "hero-stars-1-b", delay: "-1s", rate: "0.10" },
	{ className: "hero-stars-1-c", delay: "-2s", rate: "0.10" },
	{ className: "hero-stars-1-d", delay: "-3s", rate: "0.10" },
	{ className: "hero-stars-2-a", delay: "-0.5s", rate: "0.05" },
	{ className: "hero-stars-2-b", delay: "-2.5s", rate: "0.05" },
];

const CLOUD_PARALLAX_RATE = "0.30";

// The moon's centre, as a CSS position on the hero. Shared by the disc and the
// glow that lights the corner around it, so the light can never drift off its
// source: the disc is placed with `left`/`top` at these and the radial gradient
// is centred on the same pair. `--moon-y` carries a floor alongside its
// percentage because the percentage alone is not enough: on a short viewport 16%
// is high enough to put the disc behind the HIGH SCORES button, which is opaque
// and would clip its top. 7rem clears the button's own `top-6` + 44px minimum
// height and half a 76px disc at the largest size it reaches.
const MOON_X = "92%";
const MOON_Y = "max(7rem, 16%)";

// The glow's radius. One length, used for the whole radial falloff: the moon's
// light has to read as a lit corner rather than a tight halo, so it is keyed to
// the viewport width (a corner is a fraction of the viewport, not a fixed number
// of px) and clamped at both ends for phones and very wide displays. Note the
// ceiling this works against — `heroBg` is a light stone, so the brightest the
// wash can be is white, and the whole effect lives in the ~24/255 between them.
// Covering a large area is what makes it read; the stops below hold the
// brightness out to roughly half the radius rather than falling off at once.
const MOON_GLOW_RADIUS = "clamp(240px, 58vw, 820px)";

// When the details move below the fold, that section has to carry the game
// ground's tint itself so it reads as the ground continuing past the hero's
// bottom edge. The section is painted in the *far* end of the ground's gradient
// (`resolveGroundFarColor`), not the near ink the canvas draws at the player's
// feet: the canvas fades from the near ink at the ground line to the far ink at
// the hero's bottom edge, so the far ink is the colour the section has to
// continue from, and it is also the lighter of the two, which is what gives the
// details text its contrast. `color-mix` paints that colour at
// `GROUND_FILL_ALPHA` over the hero background, which is what the canvas does
// with the gradient's last stop, so the boundary is a colour match rather than
// a step. The mix base must be that hero background and never `transparent`:
// mixing over `transparent` composites over the *page*, which would reintroduce
// the very step this avoids. `groundTextureCssUrl` rebuilds the same
// `GROUND_TEXTURE` dirt dashes the canvas blits as a repeating SVG background,
// so the section also reads as 8-bit stratified soil rather than flat tint —
// and it is rebuilt from the *near* ink, not the far one, because the texture
// has to read as grain against the light section and the far ink is within a
// few units of the fill it would sit on. One list feeds both renderers, so they
// cannot drift. Themes without a runner get no tint and no texture.
// `background-size` scales one tile to CSS px using the 2 px-per-unit stand-in
// the canvas's live `pixelScale` cannot be reproduced with here.
//
// The grain is painted by its own absolutely-positioned layer rather than as a
// second `background-image` on the section, and that layer is the reason the
// two styles below are two constants instead of one: see `.details-ground-grain`
// in the stylesheet. The section itself carries the fill only.
//
// `heroBgBase` is the colour the hero actually paints behind the canvas. The
// one theme whose `heroBg` is `transparent` shows the page through instead, so
// it falls back to white rather than emitting a `color-mix(..., transparent)`
// that would drop the base and reintroduce the seam. The expression is the same
// one `src/pages/og/[eventId].png.ts` uses, but not for the same reason: that
// route needs an opaque colour to rasterise, whereas here the tint just needs a
// concrete base to mix into.
const heroBgBase = theme.heroBg === "transparent" ? "#ffffff" : theme.heroBg;
const groundColor = theme.runner
	? resolveGroundColor(theme.runner.ground, theme.runner.color)
	: null;
const groundFarColor =
	groundColor && theme.runner
		? resolveGroundFarColor(theme.runner.groundFar, groundColor)
		: null;
const groundFillStyle =
	groundColor && groundFarColor
		? `background-color: color-mix(in srgb, ${groundFarColor} calc(${GROUND_FILL_ALPHA} * 100%), ${heroBgBase});`
		: "";
const groundGrainStyle = groundColor
	? `background-image: ${groundTextureCssUrl(groundColor)}; background-size: ${GROUND_TEXTURE_TILE_WIDTH * GROUND_TEXTURE_CSS_SCALE}px ${GROUND_TEXTURE_TILE_HEIGHT * GROUND_TEXTURE_CSS_SCALE}px;`
	: "";
---

<section
	class="hero relative isolate flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center"
	style={heroStyle}
	data-hero
>
	{theme.moon && (
	/* The light first, then its source, and both before the star and cloud layers:
	   the glow is part of the sky, so it has to paint *behind* the specks and the
	   clouds instead of washing them out, and the moon disc is therefore also
	   behind the clouds that drift across it. Neither layer carries
	   `data-parallax`, unlike every other sky layer: the moon is the one thing up
	   there that does not move with the player, and a corner-pinned disc run
	   through the parallax transform would slide out of its own corner. */
	<div
		class="pointer-events-none absolute inset-0 z-0"
		style={`--moon-x: ${MOON_X}; --moon-y: ${MOON_Y}; --moon-glow: ${theme.moon.glow}; --moon-radius: ${MOON_GLOW_RADIUS};`}
		aria-hidden="true"
	>
		<div class="hero-moonlight absolute inset-0"></div>
		<img src="/moon/moon.svg" alt="" class="hero-moon absolute" />
	</div>
)}

	{theme.stars &&
	starLayers.map((layer) => (
		<div
			class="hero-sky-layer pointer-events-none absolute inset-0"
			data-parallax={layer.rate}
			aria-hidden="true"
		>
			<div class="hero-sky-strip" data-parallax-strip>
				{[...Array(SKY_COPIES)].map(() => (
					<div class="hero-sky-section">
						<div
							class={`hero-stars ${layer.className} motion-safe:animate-twinkle`}
							style={`animation-delay: ${layer.delay};`}
						/>
					</div>
				))}
			</div>
		</div>
	))}

	{theme.balloons?.colors.map((color, i) => (
	<div
		class={`hero-balloons hero-balloons-${i} pointer-events-none absolute inset-0 motion-safe:animate-balloon-float`}
		style={`color: ${color}; animation-delay: ${-i * 1.1}s;`}
	/>
))}

	{theme.clouds && (
	<>
		{/* Distant layer: small, slow, high in the sky. Sits in the top
		   strip so it never crosses the centered text block. The outer
		   element carries the CSS ambient drift; the inner strip carries
		   the island's player-driven parallax. */}
		<div
			class="hero-sky-layer pointer-events-none absolute inset-x-0 top-0 z-0 h-[26%] motion-safe:animate-cloud-scroll-slow motion-reduce:hidden"
			data-parallax={CLOUD_PARALLAX_RATE}
			aria-hidden="true"
		>
			<div class="hero-sky-strip" data-parallax-strip>
				{[...Array(SKY_COPIES)].map(() => (
					<div class="hero-sky-section">
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-1"
						/>
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-2"
						/>
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-3"
						/>
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-4"
						/>
					</div>
				))}
			</div>
		</div>
	</>
)}

	{/* Alternate entry point to the leaderboard. Server-rendered here, next to
	   the theme, and bound by the island through `[data-leaderboard-open]` — the
	   same idiom as `[data-hero]` and `[data-parallax]`. `z-20` puts it above the
	   sky layers (`.hero-content` is z-10, the cloud strip is z-0) and the 44px
	   minimum keeps it tappable. It is deliberately placed before `.hero-content`
	   and the game band in the DOM: the band is focused on load, so forward Tab
	   from the band reaches the hero's ground "RSVP by …" link (when the runner
	   theme renders one) and then continues into the page below the hero, while
	   Shift+Tab reaches the button directly. */}
	{/* `bg-white` is opaque on purpose: the sky layers must not read through the
	   button, and an `opacity-*` on the element would make the white translucent.
	   The understated at-rest look comes from the 70% colour instead, so `text`
	   and the `border-current` border share the same faded value; hover and
	   focus-visible restore it. The button inherits the hero's `color`, which is
	   why there is no per-element colour here. */}
	{theme.runner && (
	<button
		type="button"
		data-leaderboard-open
		class="absolute top-4 right-4 z-20 inline-flex min-h-11 items-center justify-center border-2 border-current bg-white px-3 font-heading text-[10px] tracking-wide text-current/70 uppercase transition hover:text-current focus-visible:text-current sm:top-6 sm:right-6"
	>
		HIGH SCORES
	</button>
)}

	<div
		class={`hero-content relative z-10 flex flex-col items-center ${
	theme.runner
		? "pb-[clamp(160px,22svh,200px)] [@media(max-height:639px)]:pb-12"
		: ""
}`}
	>
		<p
			class="text-base uppercase tracking-widest opacity-70 sm:text-base"
			style={`color: ${theme.heroText};`}
		>
			You're invited to
		</p>
		<h1
			class="mt-3 font-heading text-4xl font-semibold sm:text-5xl md:text-6xl lg:text-7xl"
			style={`${titleStyle} color: ${theme.accent}; ${titleMargin}`}
		>
			{title}
		</h1>
		{subtitle && (
	<h2
		class="mt-2 font-body text-2xl sm:text-2xl md:text-3xl"
		style={`color: ${theme.heroText}; opacity: 0.85; ${subtitleMargin}`}
	>
		{subtitle}
	</h2>
)}

		{/* One status line for all three phases, in the play prompt's old slot. The
		   island rewrites this single element with `textContent`, so play never
		   re-renders React. The invisible span is a spacer holding the tallest
		   message — the dead state's two lines (score, then game-over) — via
		   `deadStatus(MAX_SCORE, MAX_SCORE)`. `formatScore` pads to `SCORE_DIGITS`
		   but never truncates, so a real score can be wider than the pad; using the
		   widest score the store accepts means the reserved box can never be
		   narrower than a real score line. Without it the slot would resize when
		   the state changes, and on a narrow phone the idle prompt could wrap
		   without the slot accounting for it. The spacer carries
		   `whitespace-pre-wrap` too, or the dead
		   message's newline would collapse and the reserved height would be wrong.
		   `motion-reduce:hidden` because play is not offered there.
		   `whitespace-pre-wrap` on the visible line keeps the running message's
		   three spaces between the two score columns — so the arcade columns stay
		   aligned — and renders the dead message's newline, while still letting the
		   idle and game-over messages wrap.

		   `text-stone-600` is picked against the hero background behind it
		   — the sky here, not the ground band below — so it must be re-checked
		   (re-picked to keep ≥ 4.5:1 at `text-sm`) whenever `heroBg` moves. */}
		{theme.runner && (
	<div class="mt-4 grid place-items-center font-body text-sm tracking-widest text-stone-600 uppercase motion-reduce:hidden">
		<span
			aria-hidden="true"
			class="invisible col-start-1 row-start-1 whitespace-pre-wrap"
		>
			{deadStatus(MAX_SCORE, MAX_SCORE)}
		</span>
		<p data-runner-status class="col-start-1 row-start-1 whitespace-pre-wrap">
			{IDLE_STATUS}
		</p>
	</div>
)}

		{!theme.detailsBelowFold && (
	<EventDetails
		date={date}
		time={time}
		location={location}
		rsvpBy={rsvp_by}
		theme={theme}
	/>
)}
	</div>
	{theme.runner && (
	<RunnerGame
		client:load
		eventId={event.id}
		color={theme.runner.color}
		ground={theme.runner.ground}
		groundFar={theme.runner.groundFar}
	/>
)}
	{/* When the runner theme moves its details below the fold, the "RSVP by …"
	   link is the hero's only scroll cue, so it renders here in the game ground
	   instead of with the details. A sibling of the band, not a child. A native
	   `<a href>` is activated by Enter, not Space, so the link itself is not what
	   Space is for: the band's own keydown claims Space/ArrowUp/W (jump/start)
	   and, in the `dead` phase, Space/Enter (restart), so a focusable link inside
	   the band would have those keys captured and preventDefault-ed instead of
	   getting the browser's normal link and scroll behaviour. The band is also
	   `display: none` below ~640px viewport height, which would drop the cue.
	   `bottom-2` centres the ~20px line in the smallest (~36px) ground, and
	   `z-20` puts it above the band (`z-0`) and `.hero-content` (`z-10`) without
	   overlapping the content. No `pointer-events-none`: the hero's tap handler
	   ignores interactive targets, so the link navigates while taps beside it
	   still reach the game. */}
	{theme.runner && theme.detailsBelowFold && (
	<div class="absolute inset-x-0 bottom-2 z-20 text-center">
		<RsvpLink rsvpBy={rsvp_by} theme={theme} size="ground" />
	</div>
)}
</section>

{/* When the details move out of the hero, they need their own vertical
   rhythm: they used to be centred as part of the hero content block. They also
   drop the divider, because below the fold there is nothing above them to
   divide from, and they carry the ground tint and dirt texture so the section
   reads as the game ground continuing. The top and bottom padding match, so the
   date/time/ location block sits centred in the tinted band rather than hugging
   its top edge. The runner theme's RSVP link is not here (`showRsvp={!theme.runner}`);
   it stays in the hero's ground. */}
{theme.detailsBelowFold && (
	<section
		class="relative px-6 pt-10 pb-10 text-center sm:pt-14 sm:pb-14"
		style={groundFillStyle}
	>
		{/* The grain layer, before the content so the content can paint over it: a
		   positioned element paints above static content in the same stacking
		   context, which is why the details below sit in their own `relative`
		   wrapper. Decorative, so it is hidden from assistive tech. */}
		{theme.runner && (
			<div
				class="details-ground-grain pointer-events-none absolute inset-0"
				style={groundGrainStyle}
				aria-hidden="true"
			/>
		)}
		<div class="relative">
			<EventDetails
				date={date}
				time={time}
				location={location}
				rsvpBy={rsvp_by}
				theme={theme}
				divider={false}
				showRsvp={!theme.runner}
			/>
		</div>
	</section>
)}

<style>
/* The theme's star colour is applied through `color`, which the speck field's
   `box-shadow ... currentColor` declarations resolve against. The element's own
   background is deliberately absent: box-shadow is not painted inside the border
   box, so without it the origin speck at the section's top-left disappears while
   every scattered speck stays put. */
.hero-stars-1-a,
.hero-stars-1-b,
.hero-stars-1-c,
.hero-stars-1-d {
	width: 4px;
	height: 4px;
	color: var(--star-color);
}
.hero-stars-2-a,
.hero-stars-2-b {
	width: 2px;
	height: 2px;
	color: var(--star-color);
	opacity: 0.85;
}

.hero-stars-1-a {
	box-shadow:
		5vw 6vh currentColor,
		18vw 14vh currentColor,
		32vw 11vh currentColor,
		46vw 7vh currentColor,
		60vw 3vh currentColor,
		74vw 5vh currentColor,
		88vw 9vh currentColor,
		7vw 27vh currentColor,
		22vw 29vh currentColor,
		36vw 31vh currentColor,
		50vw 35vh currentColor,
		64vw 33vh currentColor;
}
.hero-stars-1-b {
	box-shadow:
		12vw 2vh currentColor,
		25vw 4vh currentColor,
		39vw 22vh currentColor,
		53vw 17vh currentColor,
		67vw 13vh currentColor,
		81vw 15vh currentColor,
		95vw 19vh currentColor,
		15vw 34vh currentColor,
		29vw 39vh currentColor,
		43vw 41vh currentColor,
		57vw 43vh currentColor,
		71vw 45vh currentColor;
}
.hero-stars-1-c {
	box-shadow:
		78vw 37vh currentColor,
		92vw 41vh currentColor,
		3vw 57vh currentColor,
		17vw 59vh currentColor,
		31vw 61vh currentColor,
		45vw 63vh currentColor,
		59vw 65vh currentColor,
		73vw 67vh currentColor,
		87vw 69vh currentColor,
		5vw 81vh currentColor,
		20vw 83vh currentColor,
		34vw 85vh currentColor;
}
.hero-stars-1-d {
	box-shadow:
		85vw 47vh currentColor,
		10vw 64vh currentColor,
		24vw 67vh currentColor,
		38vw 69vh currentColor,
		52vw 71vh currentColor,
		66vw 73vh currentColor,
		80vw 75vh currentColor,
		12vw 87vh currentColor,
		27vw 89vh currentColor,
		41vw 91vh currentColor,
		48vw 87vh currentColor,
		55vw 93vh currentColor;
}

.hero-stars-2-a {
	box-shadow:
		9vw 10vh currentColor,
		35vw 18vh currentColor,
		63vw 22vh currentColor,
		91vw 18vh currentColor,
		27vw 44vh currentColor,
		55vw 48vh currentColor,
		83vw 52vh currentColor,
		21vw 72vh currentColor,
		49vw 76vh currentColor,
		77vw 80vh currentColor,
		15vw 90vh currentColor,
		73vw 96vh currentColor;
}
.hero-stars-2-b {
	box-shadow:
		21vw 8vh currentColor,
		49vw 12vh currentColor,
		77vw 8vh currentColor,
		13vw 38vh currentColor,
		41vw 38vh currentColor,
		69vw 42vh currentColor,
		7vw 62vh currentColor,
		35vw 66vh currentColor,
		63vw 70vh currentColor,
		91vw 74vh currentColor,
		39vw 94vh currentColor;
}

/* Floating circle balloons: each layer is a small round bulb. Box-shadow
	   copies scatter extra balloons around the viewport edges/corners,
	   avoiding the center where the text sits. */
.hero-balloons {
	width: 30px;
	height: 30px;
	background: currentColor;
	border-radius: 50%;
	opacity: 0.7;
}
.hero-balloons-0 {
	box-shadow:
		5vw 8vh currentColor,
		18vw 6vh currentColor,
		82vw 9vh currentColor,
		95vw 12vh currentColor,
		6vw 84vh currentColor,
		16vw 90vh currentColor,
		82vw 86vh currentColor,
		94vw 92vh currentColor;
}
.hero-balloons-1 {
	box-shadow:
		10vw 14vh currentColor,
		90vw 4vh currentColor,
		3vw 76vh currentColor,
		12vw 82vh currentColor,
		88vw 78vh currentColor,
		96vw 86vh currentColor;
}
.hero-balloons-2 {
	box-shadow:
		26vw 10vh currentColor,
		74vw 14vh currentColor,
		2vw 22vh currentColor,
		97vw 22vh currentColor,
		4vw 88vh currentColor,
		92vw 90vh currentColor;
}
.hero-balloons-3 {
	box-shadow:
		34vw 6vh currentColor,
		66vw 8vh currentColor,
		8vw 70vh currentColor,
		90vw 72vh currentColor;
}
.hero-balloons-4 {
	box-shadow:
		4vw 4vh currentColor,
		96vw 16vh currentColor,
		22vw 94vh currentColor,
		78vw 96vh currentColor;
}

/* The below-fold ground's grain. It paints on its own layer so that its opacity
   can fade with depth without touching the ground fill — a mask on the section
   itself would take the fill down with it. The fade is the point: the grain is
   strongest where the band meets the hero, at the same alpha the canvas paints
   its own dashes with, so the boundary stays continuous, and it dissolves
   towards the bottom so the soil runs out where the ground does rather than
   stopping at a hard edge above the RSVP section. It also means the lower the
   details text sits, the less grain it has to read through. `mask-mode`
   defaults to `match-source`, so a gradient masks by its alpha and the colour
   below is arbitrary; the tile itself repeats and is sized from the inline
   `background-size`, exactly as it was when this was a second background layer
   on the section. */
.details-ground-grain {
	mask-image: linear-gradient(to bottom, #000, transparent);
}

/* Moonlight. One radial gradient, centred on the same `--moon-x`/`--moon-y`
   pair the disc is placed with, falling from the theme's glow colour to
   transparent. The stops are mixed towards `transparent` rather than written as
   rgba() so the theme states the colour once. Its radius is a length rather than
   a percentage: a corner of light is a fraction of the viewport's width, so letting
   the default farthest-corner sizing decide it would make the falloff drift with
   the aspect ratio. Painted behind the star and cloud layers (see the markup), so
   the corner brightens *around* them instead of fading them out. */
.hero-moonlight {
	background-image: radial-gradient(
		circle var(--moon-radius, 420px) at var(--moon-x, 90%) var(--moon-y, 15%),
		color-mix(in srgb, var(--moon-glow, #ffffff) 95%, transparent) 0%,
		color-mix(in srgb, var(--moon-glow, #ffffff) 60%, transparent) 18%,
