---
import type { CollectionEntry } from "astro:content";

interface Props {
	event: CollectionEntry<"event">;
}

const { event } = Astro.props;
const { title, subtitle, date, time, location, rsvp_by } = event.data;
---

<article
	class="mx-auto max-w-md rounded-2xl border border-stone-200 bg-stone-50 p-8 text-center shadow-sm"
>
	<p class="text-sm uppercase tracking-widest text-stone-500">You're invited to</p>
	<h1 class="mt-2 text-3xl font-semibold text-stone-900">{title}</h1>
	<h2 class="mt-1 text-lg text-stone-600">{subtitle}</h2>

	<hr class="my-6 border-stone-200" />

	<div class="space-y-1 text-stone-700">
		<p>{date}</p>
		<p>{time}</p>
		<p>{location}</p>
		<p class="pt-3 text-sm text-stone-500">RSVP by {rsvp_by}</p>
	</div>
</article>