---
import type { CollectionEntry } from "astro:content";
import Calendar from "@lucide/astro/icons/calendar";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Clock from "@lucide/astro/icons/clock";
import MapPin from "@lucide/astro/icons/map-pin";
import type { Theme } from "../lib/themes";

interface Props {
	event: CollectionEntry<"event">;
	theme: Theme;
}

const { event, theme } = Astro.props;
const { title, subtitle, date, time, location, rsvp_by } = event.data;

const heroStyle = [
	theme.stars ? `--star-color: ${theme.stars.color};` : "",
	`background: ${theme.heroBg};`,
	`color: ${theme.heroText};`,
]
	.filter(Boolean)
	.join(" ");

const titleStyle = theme.accentTextShadow
	? `text-shadow: ${theme.accentTextShadow};`
	: "";
---

<section
	class="hero relative isolate flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center"
	style={heroStyle}
>
	{
		theme.stars && (
			<>
				<div class="hero-stars hero-stars-1-a pointer-events-none absolute inset-0 motion-safe:animate-twinkle" style="animation-delay: 0s" />
				<div class="hero-stars hero-stars-1-b pointer-events-none absolute inset-0 motion-safe:animate-twinkle" style="animation-delay: -1s" />
				<div class="hero-stars hero-stars-1-c pointer-events-none absolute inset-0 motion-safe:animate-twinkle" style="animation-delay: -2s" />
				<div class="hero-stars hero-stars-1-d pointer-events-none absolute inset-0 motion-safe:animate-twinkle" style="animation-delay: -3s" />
				<div class="hero-stars hero-stars-2-a pointer-events-none absolute inset-0 motion-safe:animate-twinkle" style="animation-delay: -0.5s" />
				<div class="hero-stars hero-stars-2-b pointer-events-none absolute inset-0 motion-safe:animate-twinkle" style="animation-delay: -2.5s" />
			</>
		)
	}

	<p
		class="text-base uppercase tracking-widest opacity-70 sm:text-base"
		style={`color: ${theme.heroText};`}
	>
		You're invited to
	</p>
	<h1
		class="mt-3 font-heading text-4xl font-semibold sm:text-5xl md:text-6xl lg:text-7xl"
		style={`${titleStyle} color: ${theme.accent}; ${theme.id === "game-night" || theme.id === "game-night-light" ? "margin-top: 1.5rem;" : ""}`}
	>
		{title}
	</h1>
	<h2
		class="mt-2 font-body text-2xl sm:text-2xl md:text-3xl"
		style={`color: ${theme.heroText}; opacity: 0.85; ${theme.id === "game-night" || theme.id === "game-night-light" ? "margin-top: 2rem;" : ""}`}
	>
		{subtitle}
	</h2>

	<hr
		class="my-8 w-12 sm:my-10"
		style={`border-color: ${theme.accent}; opacity: 0.6;`}
	/>

	<div
		class="space-y-3 font-body text-xl sm:text-xl md:text-2xl"
		style={`color: ${theme.heroText};`}
	>
		<div class="flex items-center justify-center gap-2">
			<Calendar size={20} class="h-5 w-5" aria-hidden="true" />
			<span>{date}</span>
		</div>
		<div class="flex items-center justify-center gap-2">
			<Clock size={20} class="h-5 w-5" aria-hidden="true" />
			<span>{time}</span>
		</div>
		<div class="flex items-center justify-center gap-2">
			<MapPin size={20} class="h-5 w-5" aria-hidden="true" />
			<span>{location}</span>
		</div>
	</div>

	<a
		href="#rsvp"
		class="mt-6 inline-flex items-center gap-2 font-body text-xl transition sm:mt-8 md:text-2xl"
		style={`color: ${theme.heroText}; opacity: 0.75;`}
	>
		<ChevronDown
			size={16}
			class="h-4 w-4 motion-safe:animate-bounce-down"
			aria-hidden="true"
		/>
		<span class="underline underline-offset-4">RSVP by {rsvp_by}</span>
		<ChevronDown
			size={16}
			class="h-4 w-4 motion-safe:animate-bounce-down"
			aria-hidden="true"
		/>
	</a>
</section>

<style>
	.hero-stars-1-a,
	.hero-stars-1-b,
	.hero-stars-1-c,
	.hero-stars-1-d {
		width: 4px;
		height: 4px;
		background: currentColor;
	}
	.hero-stars-2-a,
	.hero-stars-2-b {
		width: 2px;
		height: 2px;
		background: currentColor;
		opacity: 0.85;
	}

	.hero-stars-1-a {
		box-shadow:
			5vw 6vh currentColor, 18vw 14vh currentColor,
			32vw 11vh currentColor, 46vw 7vh currentColor,
			60vw 3vh currentColor, 74vw 5vh currentColor,
			88vw 9vh currentColor, 7vw 27vh currentColor,
			22vw 29vh currentColor, 36vw 31vh currentColor,
			50vw 35vh currentColor, 64vw 33vh currentColor;
	}
	.hero-stars-1-b {
		box-shadow:
			12vw 2vh currentColor, 25vw 4vh currentColor,
			39vw 22vh currentColor, 53vw 17vh currentColor,
			67vw 13vh currentColor, 81vw 15vh currentColor,
			95vw 19vh currentColor, 15vw 34vh currentColor,
			29vw 39vh currentColor, 43vw 41vh currentColor,
			57vw 43vh currentColor, 71vw 45vh currentColor;
	}
	.hero-stars-1-c {
		box-shadow:
			78vw 37vh currentColor, 92vw 41vh currentColor,
			3vw 57vh currentColor, 17vw 59vh currentColor,
			31vw 61vh currentColor, 45vw 63vh currentColor,
			59vw 65vh currentColor, 73vw 67vh currentColor,
			87vw 69vh currentColor, 5vw 81vh currentColor,
			20vw 83vh currentColor, 34vw 85vh currentColor;
	}
	.hero-stars-1-d {
		box-shadow:
			85vw 47vh currentColor, 10vw 64vh currentColor,
			24vw 67vh currentColor, 38vw 69vh currentColor,
			52vw 71vh currentColor, 66vw 73vh currentColor,
			80vw 75vh currentColor, 12vw 87vh currentColor,
			27vw 89vh currentColor, 41vw 91vh currentColor,
			48vw 87vh currentColor, 55vw 93vh currentColor;
	}

	.hero-stars-2-a {
		box-shadow:
			9vw 10vh currentColor, 35vw 18vh currentColor,
			63vw 22vh currentColor, 91vw 18vh currentColor,
			27vw 44vh currentColor, 55vw 48vh currentColor,
			83vw 52vh currentColor, 21vw 72vh currentColor,
			49vw 76vh currentColor, 77vw 80vh currentColor,
			15vw 90vh currentColor, 73vw 96vh currentColor;
	}
	.hero-stars-2-b {
		box-shadow:
			21vw 8vh currentColor, 49vw 12vh currentColor,
			77vw 8vh currentColor, 13vw 38vh currentColor,
			41vw 38vh currentColor, 69vw 42vh currentColor,
			7vw 62vh currentColor, 35vw 66vh currentColor,
			63vw 70vh currentColor, 91vw 74vh currentColor,
			39vw 94vh currentColor;
	}
</style>