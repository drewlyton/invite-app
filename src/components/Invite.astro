---
import type { CollectionEntry } from "astro:content";
import type { Theme } from "../lib/themes";
import EventDetails from "./EventDetails.astro";
import RunnerGame from "./RunnerGame";

interface Props {
	event: CollectionEntry<"event">;
	theme: Theme;
}

const { event, theme } = Astro.props;
const { title, subtitle, date, time, location, rsvp_by } = event.data;

const heroStyle = [
	theme.stars ? `--star-color: ${theme.stars.color};` : "",
	`background: ${theme.heroBg};`,
	`color: ${theme.heroText};`,
]
	.filter(Boolean)
	.join(" ");

const titleStyle = theme.accentTextShadow
	? `text-shadow: ${theme.accentTextShadow};`
	: "";

// The pixel-font themes stack their hero text tightly. `game-night` keeps the
// original rhythm (the dates block still follows it). `game-night-light` moved
// its details below the fold, so the wide gap that separated the subtitle from
// the <hr> is no longer needed and the lockup tightens up.
const pixelHero = theme.id === "game-night" || theme.id === "game-night-light";
const titleMargin = pixelHero ? "margin-top: 1.5rem;" : "";
const subtitleMargin = theme.detailsBelowFold
	? "margin-top: 1rem;"
	: pixelHero
		? "margin-top: 2rem;"
		: "";

// The sky layers compose two transforms: the inner strip carries the island's
// player parallax, and the cloud layer's outer element additionally runs the
// ambient CSS drift. A transform can consume up to one section width, so the
// cloud strip needs three copies to stay covered when the drift and the player
// offset overlap at the right edge; with two it runs out of content there.
//
// Stars have no ambient drift (they hold still until the player moves), so the
// player offset alone would be safe with two copies. The constant stays shared
// at three so both families keep one strip geometry, and the spare copy costs
// nothing. Do not "optimise" it to two: that would break the clouds.
const SKY_COPIES = 3;

type StarLayer = {
	className: string;
	delay: string;
	// Parallax depth: world pixels are multiplied by this. The far 2px specks
	// move slowest, the near 4px specks a little faster, clouds fastest.
	rate: string;
};

const starLayers: StarLayer[] = [
	{ className: "hero-stars-1-a", delay: "0s", rate: "0.10" },
	{ className: "hero-stars-1-b", delay: "-1s", rate: "0.10" },
	{ className: "hero-stars-1-c", delay: "-2s", rate: "0.10" },
	{ className: "hero-stars-1-d", delay: "-3s", rate: "0.10" },
	{ className: "hero-stars-2-a", delay: "-0.5s", rate: "0.05" },
	{ className: "hero-stars-2-b", delay: "-2.5s", rate: "0.05" },
];

const CLOUD_PARALLAX_RATE = "0.30";
---

<section
	class="hero relative isolate flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center"
	style={heroStyle}
	data-hero
>
	{theme.stars &&
	starLayers.map((layer) => (
		<div
			class="hero-sky-layer pointer-events-none absolute inset-0"
			data-parallax={layer.rate}
			aria-hidden="true"
		>
			<div class="hero-sky-strip" data-parallax-strip>
				{[...Array(SKY_COPIES)].map(() => (
					<div class="hero-sky-section">
						<div
							class={`hero-stars ${layer.className} motion-safe:animate-twinkle`}
							style={`animation-delay: ${layer.delay};`}
						/>
					</div>
				))}
			</div>
		</div>
	))}

	{theme.balloons?.colors.map((color, i) => (
		<div
			class={`hero-balloons hero-balloons-${i} pointer-events-none absolute inset-0 motion-safe:animate-balloon-float`}
			style={`color: ${color}; animation-delay: ${-i * 1.1}s;`}
		/>
	))}

	{theme.clouds && (
	<>
		{/* Distant layer: small, slow, high in the sky. Sits in the top
		   strip so it never crosses the centered text block. The outer
		   element carries the CSS ambient drift; the inner strip carries
		   the island's player-driven parallax. */}
		<div
			class="hero-sky-layer pointer-events-none absolute inset-x-0 top-0 z-0 h-[26%] motion-safe:animate-cloud-scroll-slow motion-reduce:hidden"
			data-parallax={CLOUD_PARALLAX_RATE}
			aria-hidden="true"
		>
			<div class="hero-sky-strip" data-parallax-strip>
				{[...Array(SKY_COPIES)].map(() => (
					<div class="hero-sky-section">
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-1"
						/>
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-2"
						/>
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-3"
						/>
						<img
							src="/clouds/cloud-small.svg"
							alt=""
							class="hero-cloud hero-cloud-4"
						/>
					</div>
				))}
			</div>
		</div>
	</>
)}

	<div
		class={`hero-content relative z-10 flex flex-col items-center ${
	theme.runner
		? "pb-[clamp(160px,22svh,200px)] [@media(max-height:639px)]:pb-0"
		: ""
}`}
	>
		<p
			class="text-base uppercase tracking-widest opacity-70 sm:text-base"
			style={`color: ${theme.heroText};`}
		>
			You're invited to
		</p>
		<h1
			class="mt-3 font-heading text-4xl font-semibold sm:text-5xl md:text-6xl lg:text-7xl"
			style={`${titleStyle} color: ${theme.accent}; ${titleMargin}`}
		>
			{title}
		</h1>
		{subtitle && (
	<h2
		class="mt-2 font-body text-2xl sm:text-2xl md:text-3xl"
		style={`color: ${theme.heroText}; opacity: 0.85; ${subtitleMargin}`}
	>
		{subtitle}
	</h2>
)}

		{/* The idle play prompt lives in the hero content, not the band, so the
		   same message is not shown twice. The phase-specific game-over message
		   stays in the band, near the action it describes. `motion-reduce:hidden`
		   because play is not offered under reduced motion, and the scoped
		   `[data-running]` rule below hides it while a run is in flight. */}
		{theme.runner && (
		<p class="play-prompt mt-4 font-body text-sm tracking-widest text-stone-500 uppercase motion-reduce:hidden">
			Click / Space / Tap to Play
		</p>
)}

		{!theme.detailsBelowFold && (
	<EventDetails
		date={date}
		time={time}
		location={location}
		rsvpBy={rsvp_by}
		theme={theme}
	/>
)}
	</div>
	{theme.runner && (
	<RunnerGame
		client:idle
		eventId={event.id}
		color={theme.runner.color}
		ground={theme.runner.ground}
		textColor={theme.heroText}
	/>
)}
</section>

{/* When the details move out of the hero, they need their own vertical
   rhythm: they used to be centred as part of the hero content block. */}
{theme.detailsBelowFold && (
	<section class="relative px-6 pt-10 pb-2 text-center sm:pt-14">
		<EventDetails
			date={date}
			time={time}
			location={location}
			rsvpBy={rsvp_by}
			theme={theme}
		/>
	</section>
)}

<style>
/* The theme's star colour is applied through `color`, which the speck field's
   `box-shadow ... currentColor` declarations resolve against. The element's own
   background is deliberately absent: box-shadow is not painted inside the border
   box, so without it the origin speck at the section's top-left disappears while
   every scattered speck stays put. */
.hero-stars-1-a,
.hero-stars-1-b,
.hero-stars-1-c,
.hero-stars-1-d {
	width: 4px;
	height: 4px;
	color: var(--star-color);
}
.hero-stars-2-a,
.hero-stars-2-b {
	width: 2px;
	height: 2px;
	color: var(--star-color);
	opacity: 0.85;
}

.hero-stars-1-a {
	box-shadow:
		5vw 6vh currentColor,
		18vw 14vh currentColor,
		32vw 11vh currentColor,
		46vw 7vh currentColor,
		60vw 3vh currentColor,
		74vw 5vh currentColor,
		88vw 9vh currentColor,
		7vw 27vh currentColor,
		22vw 29vh currentColor,
		36vw 31vh currentColor,
		50vw 35vh currentColor,
		64vw 33vh currentColor;
}
.hero-stars-1-b {
	box-shadow:
		12vw 2vh currentColor,
		25vw 4vh currentColor,
		39vw 22vh currentColor,
		53vw 17vh currentColor,
		67vw 13vh currentColor,
		81vw 15vh currentColor,
		95vw 19vh currentColor,
		15vw 34vh currentColor,
		29vw 39vh currentColor,
		43vw 41vh currentColor,
		57vw 43vh currentColor,
		71vw 45vh currentColor;
}
.hero-stars-1-c {
	box-shadow:
		78vw 37vh currentColor,
		92vw 41vh currentColor,
		3vw 57vh currentColor,
		17vw 59vh currentColor,
		31vw 61vh currentColor,
		45vw 63vh currentColor,
		59vw 65vh currentColor,
		73vw 67vh currentColor,
		87vw 69vh currentColor,
		5vw 81vh currentColor,
		20vw 83vh currentColor,
		34vw 85vh currentColor;
}
.hero-stars-1-d {
	box-shadow:
		85vw 47vh currentColor,
		10vw 64vh currentColor,
		24vw 67vh currentColor,
		38vw 69vh currentColor,
		52vw 71vh currentColor,
		66vw 73vh currentColor,
		80vw 75vh currentColor,
		12vw 87vh currentColor,
		27vw 89vh currentColor,
		41vw 91vh currentColor,
		48vw 87vh currentColor,
		55vw 93vh currentColor;
}

.hero-stars-2-a {
	box-shadow:
		9vw 10vh currentColor,
		35vw 18vh currentColor,
		63vw 22vh currentColor,
		91vw 18vh currentColor,
		27vw 44vh currentColor,
		55vw 48vh currentColor,
		83vw 52vh currentColor,
		21vw 72vh currentColor,
		49vw 76vh currentColor,
		77vw 80vh currentColor,
		15vw 90vh currentColor,
		73vw 96vh currentColor;
}
.hero-stars-2-b {
	box-shadow:
		21vw 8vh currentColor,
		49vw 12vh currentColor,
		77vw 8vh currentColor,
		13vw 38vh currentColor,
		41vw 38vh currentColor,
		69vw 42vh currentColor,
		7vw 62vh currentColor,
		35vw 66vh currentColor,
		63vw 70vh currentColor,
		91vw 74vh currentColor,
		39vw 94vh currentColor;
}

/* Floating circle balloons: each layer is a small round bulb. Box-shadow
	   copies scatter extra balloons around the viewport edges/corners,
	   avoiding the center where the text sits. */
.hero-balloons {
	width: 30px;
	height: 30px;
	background: currentColor;
	border-radius: 50%;
	opacity: 0.7;
}
.hero-balloons-0 {
	box-shadow:
		5vw 8vh currentColor,
		18vw 6vh currentColor,
		82vw 9vh currentColor,
		95vw 12vh currentColor,
		6vw 84vh currentColor,
		16vw 90vh currentColor,
		82vw 86vh currentColor,
		94vw 92vh currentColor;
}
.hero-balloons-1 {
	box-shadow:
		10vw 14vh currentColor,
		90vw 4vh currentColor,
		3vw 76vh currentColor,
		12vw 82vh currentColor,
		88vw 78vh currentColor,
		96vw 86vh currentColor;
}
.hero-balloons-2 {
	box-shadow:
		26vw 10vh currentColor,
		74vw 14vh currentColor,
		2vw 22vh currentColor,
		97vw 22vh currentColor,
		4vw 88vh currentColor,
		92vw 90vh currentColor;
}
.hero-balloons-3 {
	box-shadow:
		34vw 6vh currentColor,
		66vw 8vh currentColor,
		8vw 70vh currentColor,
		90vw 72vh currentColor;
}
.hero-balloons-4 {
	box-shadow:
		4vw 4vh currentColor,
		96vw 16vh currentColor,
		22vw 94vh currentColor,
		78vw 96vh currentColor;
}

/* Sky parallax. Each layer is two nested elements: the outer element runs the
   ambient CSS drift (seamless because it translates exactly one section),
   while the inner strip is translated by the island for player parallax. The
   strip carries three identical copies so it stays covered while both
   transforms are applied at once. The strip sits at z-index 0; .hero-content
   wraps the text at z-10 so the text always paints on top. */
.hero-sky-strip {
	display: flex;
	width: 300%;
	height: 100%;
	image-rendering: pixelated;
}
/* Promote the strips only while a run is in flight. Idle has no JS transform
   writes at all, so a permanent will-change keeps seven 3x-hero-width
   compositor layers alive for nothing. Scoping it to `[data-running]` leaves
   idle with none of the star strips promoted (only the cloud strip, via its
   parent's ambient animation) and restores all seven while a run is playing.
   Dropping will-change outright is not equivalent: with the transform written
   by JS but no will-change, Chrome does not promote the six star strips during
   play. `data-running` is set by RunnerGame while the run is running and
   removed on idle/death. */
[data-running] .hero-sky-strip {
	will-change: transform;
}
/* The hero gets `data-running` from the island while a run is in flight. Hide
   the idle play prompt then, purely in CSS — no React state, so starting a run
   does not re-render the island. */
[data-running] .play-prompt {
	display: none;
}
.hero-sky-section {
	flex: 1 0 33.3333%;
	position: relative;
	height: 100%;
}
.hero-cloud {
	position: absolute;
	image-rendering: pixelated;
}

/* Small (distant) clouds: scattered high in the sky */
.hero-sky-section .hero-cloud-1 {
	top: 8%;
	left: 4%;
	width: 90px;
	height: auto;
}
.hero-sky-section .hero-cloud-2 {
	top: 22%;
	left: 22%;
	width: 70px;
	height: auto;
}
.hero-sky-section .hero-cloud-3 {
	top: 4%;
	left: 38%;
	width: 110px;
	height: auto;
}
.hero-sky-section .hero-cloud-4 {
	top: 28%;
	left: 52%;
	width: 80px;
	height: auto;
}

@media (prefers-reduced-motion: reduce) {
	.hero-balloons {
		opacity: 0.55;
	}
}
</style>
