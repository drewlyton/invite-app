---
import Calendar from "@lucide/astro/icons/calendar";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Clock from "@lucide/astro/icons/clock";
import MapPin from "@lucide/astro/icons/map-pin";
import type { Theme } from "../lib/themes";

interface Props {
	date: string;
	time: string;
	location: string;
	rsvpBy: string;
	theme: Theme;
	/** Render the divider rule above the details. Defaults to true. */
	divider?: boolean;
}

const { date, time, location, rsvpBy, theme, divider = true } = Astro.props;
---

{divider && (
<hr
	class="my-8 w-12 sm:my-10"
	style={`border-color: ${theme.accent}; opacity: 0.6;`}
>
)}

<div
	class="space-y-3 font-body text-xl sm:text-xl md:text-2xl"
	style={`color: ${theme.heroText};`}
>
	<div class="flex items-center justify-center gap-2">
		<Calendar size={20} class="h-5 w-5" aria-hidden="true" />
		<span>{date}</span>
	</div>
	<div class="flex items-center justify-center gap-2">
		<Clock size={20} class="h-5 w-5" aria-hidden="true" />
		<span>{time}</span>
	</div>
	<div class="flex items-center justify-center gap-2">
		<MapPin size={20} class="h-5 w-5" aria-hidden="true" />
		<span>{location}</span>
	</div>
</div>

<a
	href="#rsvp"
	class="mt-6 inline-flex items-center gap-2 font-body text-xl transition sm:mt-8 md:text-2xl"
	style={`color: ${theme.heroText}; opacity: 0.75;`}
>
	<ChevronDown
		size={16}
		class="h-4 w-4 motion-safe:animate-bounce-down"
		aria-hidden="true"
	/>
	<span class="underline underline-offset-4">RSVP by {rsvpBy}</span>
	<ChevronDown
		size={16}
		class="h-4 w-4 motion-safe:animate-bounce-down"
		aria-hidden="true"
	/>
</a>
