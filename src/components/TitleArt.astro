---
import type { TitleArtName } from "../lib/title-art";

/**
 * The pixel-art lockups that can stand in for an event's plain-text `title`.
 *
 * An event opts in through `title_art` in its frontmatter; `Invite.astro` then
 * renders one of these inside the `<h1>` instead of the title string. The art is
 * presentational only: each lockup also renders the event's `title` as `sr-only`
 * text, so the heading, the page title and `og:title` all still read the words
 * even though nothing on screen does.
 *
 * Each lockup is inline SVG rather than a file under `public/` so the glyphs can
 * take their colour from `currentColor`: the theme's accent then drives the art
 * exactly as it drove the heading text.
 *
 * `drew-30th` is drawn to be read as centred on the `DREW'S` / `30` / `B'DAY`
 * stack, with the `TH` hanging off the right of the `30` rather than counting
 * towards the width. The rows do not share a centre in the source artwork (the
 * `30` sits ~4.96 units left of the two words), so the `30` and `TH` groups are
 * translated right by 4.96 units to bring all three onto one axis. The viewBox
 * is then cut tight to that stack, which leaves the `TH` outside it, painted by
 * `overflow: visible` in the stylesheet.
 *
 * `variant` picks the sizing contract. `hero` (the default) sizes the lockup
 * against the viewport, because it has to share a full-screen hero with the
 * runner band. `print` hands sizing to its container instead, because the
 * printable poster is a fixed-size sheet with no viewport to answer to.
 */

interface Props {
	name: TitleArtName;
	/**
	 * The words the art spells out, taken from the event's `title`. Rendered
	 * `sr-only` beside the artwork so the heading they sit in is named by the
	 * sentence and not by nothing at all.
	 */
	label: string;
	variant?: "hero" | "print";
}

const { name, label, variant = "hero" } = Astro.props;

const artClass =
	variant === "print" ? "title-art title-art-print" : "title-art";
---

