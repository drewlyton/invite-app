# Resend (https://resend.com) — transactional email over HTTPS.
#
# Setup:
#   1. Create a Resend account and verify your sending domain
#      (https://resend.com/domains). Until you verify a domain you'll be
#      limited to the default `onboarding@resend.dev` sender, which only
#      delivers to your account's own email — fine for testing, not for
#      real invites.
#   2. Create an API key (https://resend.com/api-keys).
#   3. Copy this file to `.env` and fill in the values.
#
# IMPORTANT: `.env` is already in `.gitignore`.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be a verified domain in Resend unless you keep
# the default below for testing.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Invites

# Optional: where replies should go. Defaults to RESEND_FROM_EMAIL.
# RESEND_REPLY_TO=you@yourdomain.com
