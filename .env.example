# Gmail SMTP credentials for sending RSVP confirmation emails.
#
# Setup:
#   1. Enable 2-Step Verification on the Google account:
#      https://myaccount.google.com/security
#   2. Create an App Password for "Mail":
#      https://myaccount.google.com/apppasswords
#   3. Copy the 16-character password (spaces don't matter).
#
# IMPORTANT: copy this file to `.env` and fill in the real values.
# `.env` is already in `.gitignore`.

GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional: customize the sender name and reply-to address.
# GMAIL_FROM_NAME=Invites
# GMAIL_REPLY_TO=you@gmail.com
